---
const features = [
  { title: "Lokasi Strategis", desc: "Berada di jalur utama Cibinong yang ramai dilalui, dekat pemukiman dan pusat aktivitas.", icon: "M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" },
  { title: "Legalitas Jelas", desc: "Sertifikat SHM dan IMB/PBG lengkap, proses jual beli aman dan transparan.", icon: "M9 12.75 11.25 15 15 9.75M21 12c0 1.27-.63 2.39-1.6 3.07.21 1.17-.13 2.42-1.03 3.32-.9.9-2.15 1.24-3.32 1.03A3.74 3.74 0 0 1 12 21c-1.27 0-2.39-.63-3.07-1.6-1.17.21-2.42-.13-3.32-1.03-.9-.9-1.24-2.15-1.03-3.32A3.74 3.74 0 0 1 3 12c0-1.27.63-2.39 1.6-3.07-.21-1.17.13-2.42 1.03-3.32.9-.9 2.15-1.24 3.32-1.03A3.74 3.74 0 0 1 12 3c1.27 0 2.39.63 3.07 1.6 1.17-.21 2.42.13 3.32 1.03.9.9 1.24 2.15 1.03 3.32A3.74 3.74 0 0 1 21 12Z" },
  { title: "Akses Mudah", desc: "Dekat akses tol Jagorawi, Stadion Pakansari, dan transportasi umum.", icon: "M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.38A1.13 1.13 0 0 1 2.25 17.6V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.13c.62 0 1.13-.5 1.09-1.12a17.9 17.9 0 0 0-3.21-9.42 1.6 1.6 0 0 0-1.29-.71H14.25M16.5 18.75h-2.25m0-11.18V6.11c0-.57-.42-1.05-.99-1.11a48.5 48.5 0 0 0-10.02 0c-.56.06-.99.54-.99 1.11v8.14" },
  { title: "Pembayaran Fleksibel", desc: "Tersedia opsi cash keras, cash bertahap, maupun KPR dengan bank rekanan.", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" },
];
---

<section id="keunggulan" class="scroll-mt-16 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <p class="font-semibold text-teal-600">Kenapa Memilih Kami</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Investasi aman, usaha lancar</h2>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <div class="rounded-2xl border border-gray-200 p-6 transition hover:border-teal-200 hover:shadow-sm">
          <div class="inline-flex rounded-xl bg-teal-50 p-3 text-teal-600">
            <svg aria-hidden="true" class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">{f.title}</h3>
          <p class="mt-2 text-sm/relaxed text-pretty text-gray-600">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
