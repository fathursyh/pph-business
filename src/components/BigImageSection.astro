---
import { SITE } from "../data/site";

const points = [
  "5 menit ke Stadion Pakansari",
  "10 menit ke gerbang Tol Jagorawi",
  "Dekat sekolah, pasar, dan perumahan padat",
  "Lalu lintas ramai sepanjang hari",
];
---

<section id="lokasi" class="scroll-mt-16 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 md:items-center lg:gap-16">
      <div>
        <p class="font-semibold text-teal-600">Lokasi</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Di jantung pertumbuhan Cibinong</h2>
        <p class="mt-4 text-pretty text-gray-600">
          {SITE.address}. Kawasan dengan pertumbuhan penduduk dan bisnis yang pesat — ideal untuk toko,
          kantor, klinik, kafe, maupun gudang distribusi.
        </p>

        <ul class="mt-6 space-y-3">
          {points.map((p) => (
            <li class="flex items-start gap-3 text-gray-700">
              <svg aria-hidden="true" class="mt-0.5 size-5 shrink-0 text-teal-600" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
              </svg>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <div class="overflow-hidden rounded-2xl shadow-lg ring-1 ring-gray-200">
        <iframe
          title="Peta lokasi"
          src={`https://www.google.com/maps?q=${encodeURIComponent(SITE.address)}&output=embed`}
          class="aspect-4/3 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
