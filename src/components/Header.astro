---
import { SITE, waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const links = [
  { href: "#ruko", label: "Pilihan Ruko" },
  { href: "#keunggulan", label: "Keunggulan" },
  { href: "#lokasi", label: "Lokasi" },
  { href: "#testimoni", label: "Testimoni" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-gray-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="#" class="flex items-center gap-2 font-bold text-gray-900">
      <span class="grid size-9 place-content-center rounded-lg bg-teal-600 text-white">
        <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M4 21V8l8-5 8 5v13M9 21v-6h6v6M8 11h2m4 0h2" />
        </svg>
      </span>
      {SITE.name}
    </a>

    <nav aria-label="Utama" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium">
        {links.map((l) => (
          <li><a class="text-gray-600 transition hover:text-teal-600" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-green-700 sm:inline-flex"
      >
        <WhatsAppIcon /> Hubungi Kami
      </a>

      <details class="group relative md:hidden">
        <summary class="list-none rounded-lg bg-gray-100 p-2 text-gray-700 [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Buka menu</span>
          <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-xl border border-gray-100 bg-white p-2 text-sm shadow-lg">
          {links.map((l) => (
            <li><a class="block rounded-lg px-3 py-2 text-gray-700 hover:bg-gray-50" href={l.href}>{l.label}</a></li>
          ))}
          <li>
            <a href={waLink()} target="_blank" rel="noopener" class="mt-1 flex items-center gap-2 rounded-lg bg-green-600 px-3 py-2 font-semibold text-white">
              <WhatsAppIcon class="size-4" /> WhatsApp
            </a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>
