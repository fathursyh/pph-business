---
import { SITE, waLink } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const YEAR = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <!-- CTA -->
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-teal-600 p-8 sm:p-10 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Siap survei lokasi?</h2>
        <p class="mt-2 text-teal-50">Konsultasi gratis, respon cepat di jam kerja.</p>
      </div>
      <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-semibold text-teal-700 shadow-sm transition hover:bg-teal-50">
        <WhatsAppIcon /> Chat WhatsApp Sekarang
      </a>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <p class="text-lg font-bold text-white">{SITE.name}</p>
      <p class="mt-2 text-sm text-gray-400">{SITE.tagline}</p>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-white">Alamat</p>
      <p class="mt-2 text-gray-400">{SITE.address}</p>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-white">Jam Operasional</p>
      <p class="mt-2 text-gray-400">{SITE.hours}</p>
    </div>
  </div>

  <p class="border-t border-gray-800 py-6 text-center text-sm text-gray-500">
    &copy; {YEAR} {SITE.name}. Hak cipta dilindungi.
  </p>

  <!-- Floating WhatsApp button -->
  <a
    href={waLink()}
    target="_blank"
    rel="noopener"
    class="fixed bottom-5 right-5 z-50 grid size-14 place-content-center rounded-full bg-green-600 text-white shadow-lg transition hover:scale-105 hover:bg-green-700"
  >
    <span class="sr-only">Chat WhatsApp</span>
    <WhatsAppIcon class="size-7" />
  </a>
</footer>
